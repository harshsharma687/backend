# NovaPlay — environment variables template
# Copy this file to .env and fill in real values. In production, set these in
# your hosting dashboard (Render/Railway/Fly/... → Environment).

# Port the server listens on (optional; defaults to 8000)
PORT=8000

# production | development — controls cookie secure/sameSite behaviour
NODE_ENV=development

# MongoDB Atlas connection string ( WITHOUT the database name )
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net

# Comma-separated list of extra allowed origins for CORS (frontend domains).
# Same-origin requests always work. Example:
# CORS_ORIGIN=https://novaplay.vercel.app,http://localhost:5173
CORS_ORIGIN=

# Name of the app database
DB_NAME=video-streaming

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary (image/video storage) — dashboard → Product environment credentials
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
